# ==============================================================================
# Insight Pest Solutions - Backend Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Application Profile
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insightpest_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Hibernate & JPA
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# Security & CORS
JWT_SECRET=InsightPestEnterpriseSecretKey9876543210SecureTokenKey
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Third-Party Tool Integrations
# ------------------------------------------------------------------------------

# Transactional Email (SendGrid / Mailgun / AWS SES / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=support@insightpestsolutions.demo

# SMS Technician Dispatch & Alerts (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloud File Storage / Inspection Photos (AWS S3 / Cloudinary)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=insightpest-inspection-photos
AWS_REGION=us-east-1
